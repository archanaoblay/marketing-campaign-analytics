        "# ============================================================\n",
        "# 📊 Marketing Campaign Performance & ROAS Analysis\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Load Dataset\n",
        "# Make sure marketing_campaign_data.csv is uploaded to your Colab session storage\n",
        "df = pd.read_csv('marketing_campaign_data.csv')\n",
        "\n",
        "# 2. Aggregate Data by Marketing Channel\n",
        "channel_perf = df.groupby('channel').agg({\n",
        "    'spend': 'sum',\n",
        "    'revenue': 'sum',\n",
        "    'impressions': 'sum',\n",
        "    'clicks': 'sum',\n",
        "    'conversions': 'sum'\n",
        "}).reset_index()\n",
        "\n",
        "# 3. Calculate Core Marketing KPIs\n",
        "channel_perf['ROAS'] = (channel_perf['revenue'] / channel_perf['spend']).round(2)\n",
        "channel_perf['CTR_%'] = ((channel_perf['clicks'] / channel_perf['impressions']) * 100).round(2)\n",
        "channel_perf['CPA'] = (channel_perf['spend'] / channel_perf['conversions']).round(2)\n",
        "\n",
        "# Display Summary Table\n",
        "print(\"==========================================================\")\n",
        "print(\"             CHANNEL PERFORMANCE SUMMARY                 \")\n",
        "print(\"==========================================================\")\n",
        "print(channel_perf.sort_values(by='ROAS', ascending=False).to_string(index=False))\n",
        "print(\"\\n\")\n",
        "\n",
        "# 4. Set Chart Aesthetics\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "# Chart 1: Return on Ad Spend (ROAS) by Channel\n",
        "plt.figure(figsize=(10, 5))\n",
        "sns.barplot(\n",
        "    data=channel_perf.sort_values(by='ROAS', ascending=False),\n",
        "    x='channel',\n",
        "    y='ROAS',\n",
        "    hue='channel',\n",
        "    palette='Blues_d',\n",
        "    legend=False\n",
        ")\n",
        "plt.title('Return on Ad Spend (ROAS) by Marketing Channel', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Marketing Channel', fontsize=12)\n",
        "plt.ylabel('ROAS ($ Revenue / $ Spend)', fontsize=12)\n",
        "plt.tight_layout()\n",
        "plt.savefig('roas_by_channel.png', dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# Chart 2: Total Spend vs. Revenue by Device Type\n",
        "device_perf = df.groupby('device')[['spend', 'revenue']].sum().reset_index()\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "device_perf.plot(\n",
        "    x='device',\n",
        "    kind='bar',\n",
        "    stacked=False,\n",
        "    figsize=(8, 5),\n",
        "    color=['#e74c3c', '#2ecc71']\n",
        ")\n",
        "plt.title('Total Spend vs. Revenue by Device Type', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Device Type', fontsize=12)\n",
        "plt.ylabel('Amount ($)', fontsize=12)\n",
        "plt.xticks(rotation=0)\n",
        "plt.legend(['Total Spend', 'Total Revenue'])\n",
        "plt.tight_layout()\n",
        "plt.savefig('device_performance.png', dpi=300)\n",
        "plt.show()"
